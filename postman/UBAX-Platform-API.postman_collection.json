                    },
                    {
                      "key": "logo",
                      "type": "file",
                      "src": "",
                      "description": "Logo (JPEG/PNG/WEBP, max 5 MB)",
                      "disabled": true
                    }
                  ]
                },
                "url": {
                  "raw": "{{base_url}}/v1/partner/apply",
                  "host": ["{{base_url}}"],
                  "path": ["v1", "partner", "apply"]
                },
                "description": "Soumettre une candidature partenaire (multipart). Pas d'authentification requise.",
                "auth": { "type": "noauth" }
              }
            }
          ]
        },
        {
          "name": "Admin",
          "item": [
            {
              "name": "List Partner Applications",
              "request": {
                "method": "GET",
                "url": {
                  "raw": "{{base_url}}/v1/partner/admin/applications?page=0&size=20&sort=submittedAt,desc",
                  "host": ["{{base_url}}"],
                  "path": ["v1", "partner", "admin", "applications"],
                  "query": [
                    { "key": "page", "value": "0" },
                    { "key": "size", "value": "20" },
                    { "key": "sort", "value": "submittedAt,desc" },
                    { "key": "status", "value": "PENDING", "disabled": true }
                  ]
                },
                "description": "Admin : Lister toutes les candidatures partenaires. Filtres : PENDING, UNDER_REVIEW, INCOMPLETE, APPROVED, REJECTED."
              }
            },
            {
              "name": "Get Partner Application Details",
              "request": {
                "method": "GET",
                "url": {
                  "raw": "{{base_url}}/v1/partner/admin/applications/{{partner_application_id}}",
                  "host": ["{{base_url}}"],
                  "path": ["v1", "partner", "admin", "applications", "{{partner_application_id}}"]
                },
                "description": "Admin : Détail d'une candidature partenaire."
              }
            },
            {
              "name": "Approve Application",
              "request": {
                "method": "PATCH",
                "url": {
                  "raw": "{{base_url}}/v1/partner/admin/applications/{{partner_application_id}}/decision?newStatus=APPROVED&comment=Dossier complet et validé",
                  "host": ["{{base_url}}"],
                  "path": ["v1", "partner", "admin", "applications", "{{partner_application_id}}", "decision"],
                  "query": [
                    { "key": "newStatus", "value": "APPROVED" },
                    { "key": "comment", "value": "Dossier complet et validé" }
                  ]
                },
                "description": "Admin : Approuver une candidature partenaire."
              }
            },
            {
              "name": "Reject Application",
              "request": {
                "method": "PATCH",
                "url": {
                  "raw": "{{base_url}}/v1/partner/admin/applications/{{partner_application_id}}/decision?newStatus=REJECTED&comment=Documents non conformes",
