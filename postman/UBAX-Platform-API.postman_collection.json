            "description": "Upload ou remplacement de l'avatar utilisateur. Formats : JPEG, PNG, WEBP. Taille max : 5 MB."
          }
        }
      ]
    },
    {
      "name": "Tenants",
      "description": "Gestion des profils locataires (KYC)",
      "item": [
        {
          "name": "Client",
          "item": [
            {
              "name": "Create Tenant Profile",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "if (pm.response.code === 200 || pm.response.code === 201) {",
                      "    var json = pm.response.json();",
                      "    if (json.data && json.data.id) {",
                      "        pm.environment.set('tenant_id', json.data.id);",
                      "    }",
                      "}"
                    ]
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"employmentStatus\": \"SALARIE\",\n  \"employerName\": \"UBAX Corp\",\n  \"monthlyIncome\": 500000,\n  \"hasGuarantor\": true,\n  \"guarantorName\": \"Jane Doe\",\n  \"guarantorPhone\": \"+2250700000000\",\n  \"guarantorEmail\": \"jane.doe@example.com\"\n}"
                },
                "url": {
                  "raw": "{{base_url}}/v1/tenants/profile",
                  "host": ["{{base_url}}"],
                  "path": ["v1", "tenants", "profile"]
                },
                "description": "Client : Créer un profil locataire (dossier KYC)."
              }
            },
            {
              "name": "Get My Tenant Profile",
              "request": {
                "method": "GET",
                "url": {
                  "raw": "{{base_url}}/v1/tenants/profile",
                  "host": ["{{base_url}}"],
                  "path": ["v1", "tenants", "profile"]
                },
                "description": "Récupérer mon profil locataire."
              }
            },
            {
              "name": "Update My Tenant Profile",
              "request": {
                "method": "PATCH",
                "header": [
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"employmentStatus\": \"SALARIE\",\n  \"employerName\": \"Updated Corp\",\n  \"monthlyIncome\": 750000,\n  \"hasGuarantor\": false,\n  \"idDocumentUrl\": \"https://minio.example.com/tenant-documents/id.pdf\",\n  \"idDocumentType\": \"CNI\",\n  \"idDocumentNumber\": \"CI-123456789\",\n  \"idDocumentExpiry\": \"2028-12-31\",\n  \"incomeProofUrl\": \"https://minio.example.com/tenant-documents/income.pdf\",\n  \"addressProofUrl\": \"https://minio.example.com/tenant-documents/address.pdf\"\n}"
                },
                "url": {
                  "raw": "{{base_url}}/v1/tenants/profile",
                  "host": ["{{base_url}}"],
                  "path": ["v1", "tenants", "profile"]
                },
                "description": "Client : Mettre à jour mon profil locataire."
              }
            }
          ]
        },
        {
          "name": "Admin / Agent",
          "item": [
            {
              "name": "List All Tenants (Paginated)",
              "request": {
                "method": "GET",
                "url": {
                  "raw": "{{base_url}}/v1/tenants?page=0&size=20&sort=createdAt,desc",
                  "host": ["{{base_url}}"],
                  "path": ["v1", "tenants"],
                  "query": [
                    { "key": "page", "value": "0" },
                    { "key": "size", "value": "20" },
                    { "key": "sort", "value": "createdAt,desc" },
                    { "key": "status", "value": "PENDING_REVIEW", "disabled": true }
                  ]
                },
                "description": "Admin/Agent : Lister tous les profils locataires avec pagination. Filtres optionnels : INCOMPLETE, PENDING_REVIEW, QUALIFIED, REJECTED, BLACKLISTED."
              }
            },
            {
              "name": "Get Tenant by ID",
              "request": {
                "method": "GET",
                "url": {
                  "raw": "{{base_url}}/v1/tenants/{{tenant_id}}",
                  "host": ["{{base_url}}"],
                  "path": ["v1", "tenants", "{{tenant_id}}"]
                },
                "description": "Admin/Agent : Détail d'un profil locataire par ID."
              }
            },
            {
              "name": "Qualify Tenant",
              "request": {
                "method": "PATCH",
                "url": {
                  "raw": "{{base_url}}/v1/tenants/{{tenant_id}}/qualify",
                  "host": ["{{base_url}}"],
                  "path": ["v1", "tenants", "{{tenant_id}}", "qualify"]
                },
                "description": "Admin/Agent : Qualifier (approuver) un profil locataire."
              }
            },
            {
              "name": "Reject Tenant",
              "request": {
                "method": "PATCH",
                "url": {
                  "raw": "{{base_url}}/v1/tenants/{{tenant_id}}/reject?reason=Documents incomplets",
                  "host": ["{{base_url}}"],
                  "path": ["v1", "tenants", "{{tenant_id}}", "reject"],
                  "query": [
                    { "key": "reason", "value": "Documents incomplets" }
                  ]
                },
                "description": "Admin/Agent : Rejeter un profil locataire (motif obligatoire)."
              }
            },
            {
              "name": "Archive Tenant (Soft Delete)",
              "request": {
                "method": "DELETE",
                "url": {
                  "raw": "{{base_url}}/v1/tenants/{{tenant_id}}",
                  "host": ["{{base_url}}"],
                  "path": ["v1", "tenants", "{{tenant_id}}"]
                },
                "description": "Admin/Agent : Archiver (suppression logique) un profil locataire."
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Storage",
      "description": "Gestion du stockage MinIO (upload de fichiers)",
      "item": [
        {
          "name": "Get Presigned Upload URL",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/v1/storage/presign?bucket=tenant-documents&key=my-file.pdf&expires=900",
              "host": ["{{base_url}}"],
              "path": ["v1", "storage", "presign"],
              "query": [
                { "key": "bucket", "value": "tenant-documents", "description": "Buckets: properties-media, property-documents, tenant-documents, agencies-logos, users-avatars, ticket-attachments" },
                { "key": "key", "value": "my-file.pdf", "description": "Nom du fichier (optionnel, auto-généré si absent)" },
                { "key": "expires", "value": "900", "description": "Durée de validité en secondes (défaut: 900, max: 3600)" }
              ]
            },
            "description": "Générer une URL presignée PUT pour uploader un fichier vers MinIO."
          }
        }
      ]
    },
    {
      "name": "Partners",
      "description": "Gestion des candidatures partenaires",
      "item": [
        {
          "name": "Public",
          "item": [
            {
              "name": "Apply as Partner (Multipart)",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "if (pm.response.code === 200 || pm.response.code === 201) {",
                      "    var json = pm.response.json();",
                      "    if (json.data && json.data.id) {",
                      "        pm.environment.set('partner_application_id', json.data.id);",
                      "    }",
                      "}"
                    ]
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [],
                "body": {
                  "mode": "formdata",
                  "formdata": [
                    {
                      "key": "data",
                      "value": "{\n  \"partnerType\": \"AGENCY\",\n  \"companyName\": \"Immobilière ABC\",\n  \"legalRepresentative\": \"Jean Dupont\",\n  \"phone\": \"+2250700000000\",\n  \"email\": \"contact@abc-immo.ci\",\n  \"country\": \"CI\",\n  \"city\": \"Abidjan\",\n  \"postalAddress\": \"BP 1234 Abidjan\",\n  \"zone\": \"Cocody\",\n  \"description\": \"Agence immobilière spécialisée en location\",\n  \"legalStatus\": \"SARL\",\n  \"registrationNumber\": \"CI-ABJ-2024-00123\"\n}",
                      "type": "text",
                      "contentType": "application/json",
                      "description": "Données JSON de la candidature"
                    },
                    {
                      "key": "rccm",
                      "type": "file",
                      "src": "",
                      "description": "RCCM (PDF/JPEG/PNG, max 10 MB)"
                    },
                    {
                      "key": "dfe",
                      "type": "file",
                      "src": "",
                      "description": "DFE (PDF/JPEG/PNG, max 10 MB)"
                    },
                    {
                      "key": "bail",
                      "type": "file",
                      "src": "",
                      "description": "Bail (PDF/JPEG/PNG, max 10 MB)",
