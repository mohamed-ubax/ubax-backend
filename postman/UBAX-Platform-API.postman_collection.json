{
  "info": {
    "name": "UBAX Platform API",
    "description": "Collection complète des APIs UBAX Platform\n\nBase URL: {{base_url}}\nAuthentification: Keycloak OAuth2 (JWT Bearer Token)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [""]
      }
    }
  ],
  "variable": [],
  "item": [
    {
      "name": "Auth",
      "description": "Endpoints d'authentification, inscription, et gestion des mots de passe",
      "item": [
        {
          "name": "Login",
          "item": [
            {
              "name": "Login (Email/Password)",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "if (pm.response.code === 200) {",
                      "    var json = pm.response.json();",
                      "    if (json.data) {",
                      "        pm.environment.set('access_token', json.data.access_token);",
                      "        pm.environment.set('refresh_token', json.data.refresh_token);",
                      "    }",
                      "}"
                    ]
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"{{test_email}}\",\n  \"password\": \"{{test_password}}\"\n}"
                },
                "url": {
                  "raw": "{{base_url}}/v1/auth/login",
                  "host": ["{{base_url}}"],
                  "path": ["v1", "auth", "login"]
                },
                "description": "Connexion avec email et mot de passe. Les tokens sont automatiquement sauvegardés dans l'environnement.",
                "auth": { "type": "noauth" }
              }
            },
            {
              "name": "Login by Phone (Mobile)",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "if (pm.response.code === 200) {",
                      "    var json = pm.response.json();",
                      "    if (json.data) {",
                      "        pm.environment.set('access_token', json.data.access_token);",
                      "        pm.environment.set('refresh_token', json.data.refresh_token);",
                      "    }",
                      "}"
                    ]
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"phone\": \"{{test_phone}}\",\n  \"password\": \"{{test_password}}\"\n}"
                },
                "url": {
                  "raw": "{{base_url}}/v1/auth/login/phone",
                  "host": ["{{base_url}}"],
                  "path": ["v1", "auth", "login", "phone"]
                },
                "description": "Connexion avec numéro de téléphone et mot de passe (mobile).",
                "auth": { "type": "noauth" }
              }
            },
            {
              "name": "Logout",
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"refreshToken\": \"{{refresh_token}}\"\n}"
                },
                "url": {
                  "raw": "{{base_url}}/v1/auth/logout",
                  "host": ["{{base_url}}"],
                  "path": ["v1", "auth", "logout"]
                },
                "description": "Déconnexion et révocation du refresh token.",
                "auth": { "type": "noauth" }
              }
            }
          ]
        },
        {
          "name": "Registration",
          "item": [
            {
              "name": "Step 1 - Send OTP",
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"phone\": \"{{test_phone}}\"\n}"
                },
                "url": {
                  "raw": "{{base_url}}/v1/auth/register/send-otp",
                  "host": ["{{base_url}}"],
                  "path": ["v1", "auth", "register", "send-otp"]
                },
                "description": "Inscription étape 1 : Envoi d'un OTP par SMS au numéro de téléphone.",
                "auth": { "type": "noauth" }
              }
            },
            {
              "name": "Step 2 - Verify OTP",
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"phone\": \"{{test_phone}}\",\n  \"code\": \"123456\"\n}"
                },
                "url": {
                  "raw": "{{base_url}}/v1/auth/register/verify-otp",
                  "host": ["{{base_url}}"],
                  "path": ["v1", "auth", "register", "verify-otp"]
                },
                "description": "Inscription étape 2 : Vérification du code OTP (6 chiffres).",
                "auth": { "type": "noauth" }
              }
            },
            {
              "name": "Step 3 - Complete Registration",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "if (pm.response.code === 200 || pm.response.code === 201) {",
                      "    var json = pm.response.json();",
                      "    if (json.data && json.data.keycloakId) {",
                      "        pm.environment.set('keycloak_user_id', json.data.keycloakId);",
                      "    }",
                      "}"
                    ]
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"phone\": \"{{test_phone}}\",\n  \"title\": \"Mr\",\n  \"firstName\": \"John\",\n  \"lastName\": \"Doe\",\n  \"email\": \"john.doe@example.com\",\n  \"password\": \"Password123!\"\n}"
                },
                "url": {
                  "raw": "{{base_url}}/v1/auth/register/complete",
                  "host": ["{{base_url}}"],
                  "path": ["v1", "auth", "register", "complete"]
                },
                "description": "Inscription étape 3 : Finaliser l'inscription avec les informations personnelles.",
                "auth": { "type": "noauth" }
              }
            }
          ]
        },
        {
          "name": "Password Reset",
          "item": [
            {
              "name": "Forgot Password (Email)",
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"{{test_email}}\"\n}"
                },
                "url": {
                  "raw": "{{base_url}}/v1/auth/forgot-password",
                  "host": ["{{base_url}}"],
                  "path": ["v1", "auth", "forgot-password"]
                },
                "description": "Demande de réinitialisation du mot de passe par email.",
                "auth": { "type": "noauth" }
              }
            },
            {
              "name": "Step 1 - Send OTP (SMS)",
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"phone\": \"{{test_phone}}\"\n}"
                },
                "url": {
                  "raw": "{{base_url}}/v1/auth/forgot-password/send-otp",
                  "host": ["{{base_url}}"],
                  "path": ["v1", "auth", "forgot-password", "send-otp"]
                },
                "description": "Réinitialisation étape 1 : Envoi d'un OTP par SMS.",
                "auth": { "type": "noauth" }
              }
            },
            {
              "name": "Step 2 - Verify OTP",
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"phone\": \"{{test_phone}}\",\n  \"code\": \"123456\"\n}"
                },
                "url": {
                  "raw": "{{base_url}}/v1/auth/forgot-password/verify-otp",
                  "host": ["{{base_url}}"],
                  "path": ["v1", "auth", "forgot-password", "verify-otp"]
                },
                "description": "Réinitialisation étape 2 : Vérification du code OTP.",
                "auth": { "type": "noauth" }
              }
            },
            {
              "name": "Step 3 - Reset Password",
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"phone\": \"{{test_phone}}\",\n  \"code\": \"123456\",\n  \"newPassword\": \"NewPassword123!\"\n}"
                },
                "url": {
                  "raw": "{{base_url}}/v1/auth/forgot-password/reset",
                  "host": ["{{base_url}}"],
                  "path": ["v1", "auth", "forgot-password", "reset"]
                },
                "description": "Réinitialisation étape 3 : Nouveau mot de passe avec le code OTP.",
                "auth": { "type": "noauth" }
              }
            }
          ]
        },
        {
          "name": "Admin",
          "item": [
            {
              "name": "Reset Password (Admin)",
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"keycloakId\": \"{{keycloak_user_id}}\",\n  \"newPassword\": \"TempPassword123!\",\n  \"temporary\": true\n}"
                },
                "url": {
                  "raw": "{{base_url}}/v1/auth/reset-password",
                  "host": ["{{base_url}}"],
                  "path": ["v1", "auth", "reset-password"]
                },
                "description": "Admin : Forcer la réinitialisation du mot de passe d'un utilisateur."
              }
            },
            {
              "name": "Get All Roles",
              "request": {
                "method": "GET",
                "url": {
                  "raw": "{{base_url}}/v1/auth/roles",
                  "host": ["{{base_url}}"],
                  "path": ["v1", "auth", "roles"]
                },
                "description": "Admin : Lister tous les rôles Keycloak disponibles."
              }
            },
            {
              "name": "Assign Role to User",
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"role\": \"CLIENT\"\n}"
                },
                "url": {
                  "raw": "{{base_url}}/v1/auth/users/{{keycloak_user_id}}/roles",
                  "host": ["{{base_url}}"],
                  "path": ["v1", "auth", "users", "{{keycloak_user_id}}", "roles"]
                },
                "description": "Admin : Assigner un rôle à un utilisateur. Rôles : CLIENT, OWNER, AGENT, AGENCY, ADMIN, SUPER_ADMIN, PARTNER"
              }
            },
            {
              "name": "Remove Role from User",
              "request": {
                "method": "DELETE",
                "header": [
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"role\": \"CLIENT\"\n}"
                },
                "url": {
                  "raw": "{{base_url}}/v1/auth/users/{{keycloak_user_id}}/roles",
                  "host": ["{{base_url}}"],
                  "path": ["v1", "auth", "users", "{{keycloak_user_id}}", "roles"]
                },
                "description": "Admin : Retirer un rôle d'un utilisateur."
              }
            }
          ]
        }
      ]
    },
    {
      "name": "User Profile",
      "description": "Gestion du profil utilisateur",
      "item": [
