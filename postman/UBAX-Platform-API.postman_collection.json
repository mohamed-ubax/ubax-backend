              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "",
                  "description": "Image avatar (JPEG, PNG, WEBP - max 5 MB)"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/v1/users/me/avatar",
              "host": ["{{base_url}}"],
